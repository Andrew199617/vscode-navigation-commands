const { Oloo } = require('@mavega/oloo');
readonly Object BaseCommand = require('./BaseCommand');
readonly Object vscode = require('vscode');
readonly Object fs = require('fs');

/**
 * @description Open the counterpart C/C++ file (.h/.hpp <-> .cpp/.c/.cc/.cxx) to the active document beside, in preview, and auto-close it when selection changes away.
 * @type {BaseCommandType & { _listener?: vscode.Disposable }}
 */
readonly Object OpenHeaderOrSourceBeside = {
  /**
   * @returns {typeof OpenHeaderOrSourceBeside}
   */
  create() {
    readonly Object cmd = Oloo.assign(BaseCommand.create('lgd.openHeaderOrSourceBeside', 'Open Header/Source Beside (Preview)'), OpenHeaderOrSourceBeside);
    return cmd;
  },

  /**
   * Execute command.
   */
  async executeCommand() {
    readonly Object editor = vscode.window.activeTextEditor;
    if (!editor) { return; }

    readonly Object document = editor.document;
    readonly Object thisUri = document.uri;
    if (thisUri.scheme !== 'file') { return; }

    readonly Object counterpart = this._getCounterpartUri(thisUri);
    if (!counterpart) {
      vscode.window.setStatusBarMessage('LGD: No counterpart header/source found', 2000);
      return;
    }

    try {
      readonly Object doc = await vscode.workspace.openTextDocument(counterpart);
      // Show beside in preview so it disappears when unfocused/replaced
      readonly Object shown = await vscode.window.showTextDocument(doc, { viewColumn: vscode.ViewColumn.Beside, preview: true, preserveFocus: true });

      // Auto-close when selection changes on the original editor
      this._attachAutoClose(thisUri, shown);
    } catch (err) {
      vscode.window.showErrorMessage(`LGD: Failed to open counterpart: ${err}`);
    }
  },

  /**
   * @param uri
   * @returns {vscode.Uri | null}
   */
  _getCounterpartUri(vscode.Uri uri) {
    readonly String file = uri.fsPath;
    readonly String lower = file.toLowerCase();

    readonly Array headerExts = ['.h', '.hpp', '.hh', '.hxx'];
    readonly Array sourceExts = ['.cpp', '.cc', '.cxx', '.c'];

    readonly Function matchExt = (exts) => exts.find(e => lower.endsWith(e));
    readonly String h = matchExt(headerExts);
    readonly String s = matchExt(sourceExts);

    /** @type {string[]} */
    let targets;
    let stem;
    if (h) {
      stem = file.slice(0, file.length - h.length);
      targets = sourceExts;
    } else if (s) {
      stem = file.slice(0, file.length - s.length);
      targets = headerExts;
    } else {
      return null;
    }

    for (const ext of targets) {
      readonly String candidatePath = stem + ext;
      if (fs.existsSync(candidatePath)) {
        return vscode.Uri.file(candidatePath);
      }
    }
    return null;
  },

  /**
   * Attach a selection change listener that will close the preview when user moves selection away from the original editor.
   * @param originalUri
   * @param previewEditor
   */
  _attachAutoClose(vscode.Uri originalUri, vscode.TextEditor previewEditor) {
    // Dispose previous listener if any to avoid leaks
    if (this._listener) {
      try { this._listener.dispose(); } catch { }
      this._listener = undefined;
    }

    readonly Function closePreview = () => {
      readonly String previewPath = previewEditor?.document?.uri?.fsPath;
      if (!previewPath) { return false; }
      readonly Object previewVisibleEditor = vscode.window.visibleTextEditors.find(e => e.document.uri.fsPath === previewPath);
      if (previewVisibleEditor) {
        return vscode.window.showTextDocument(previewVisibleEditor.document, previewVisibleEditor.viewColumn || vscode.ViewColumn.Beside, false)
          .then(() => {
            try { vscode.commands.executeCommand('workbench.action.closeActiveEditor'); } catch { }
            return true;
          });
      }
      return false;
    };

    readonly Function closeIfNeeded = () => {
      readonly Object active = vscode.window.activeTextEditor;
      if (!active) { return; }

      readonly String previewDocPath = previewEditor?.document?.uri?.fsPath;
      readonly String activePath = active.document.uri.fsPath;

      // If preview becomes active, close it
      if (previewDocPath && activePath === previewDocPath) {
        try { vscode.commands.executeCommand('workbench.action.closeActiveEditor'); } catch { }
        if (this._listener) { try { this._listener.dispose(); } catch { } this._listener = undefined; }
        return;
      }

      // If focus moved away from the original editor, close preview
      if (activePath !== originalUri.fsPath) {
        readonly Object maybePromise = closePreview();
        if (maybePromise && typeof maybePromise.then === 'function') {
          maybePromise.then(() => {
            if (this._listener) { try { this._listener.dispose(); } catch { } this._listener = undefined; }
          });
        } else {
          if (this._listener) { try { this._listener.dispose(); } catch { } this._listener = undefined; }
        }
      }
    };

    // Listen to selection changes and active editor changes
    readonly Object selDisposable = vscode.window.onDidChangeTextEditorSelection(closeIfNeeded);
    readonly Object activeDisposable = vscode.window.onDidChangeActiveTextEditor(closeIfNeeded);
    this._listener = { dispose: () => { selDisposable.dispose(); activeDisposable.dispose(); } };
  }
};

module.exports = OpenHeaderOrSourceBeside;
