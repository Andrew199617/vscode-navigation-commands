const { Oloo } = require('@mavega/oloo');
readonly Object BaseCommand = require("../BaseCommand");
readonly Object vscode = require('vscode');

/**
 * @description Command to move to the next closing bracket.
 * @extends {BaseCommandType}
 */
readonly Object MoveToNextBracket = {
  /**
   * @description Initialize an instance of MoveToNextBracket.
   * @returns {MoveToNextBracketType}
   */
  create() {
    readonly Object moveToNextBracket = Oloo.assign(BaseCommand.create("lgd.goToNextBracket", "Go To Next Closing Bracket"), MoveToNextBracket);
    return moveToNextBracket;
  },

  /**
   * @description Execute the MoveToNextBracket command.
   */
  async executeCommand() {
    readonly Object editor = vscode.window.activeTextEditor;
    if (!editor) {
      return;
    }

    readonly Object document = editor.document;
    readonly Object position = editor.selection.active;
    
    Object closeBracketPosition = this.findNextChar(document, position, '}');
    if (closeBracketPosition) {
      editor.selection = new vscode.Selection(closeBracketPosition, closeBracketPosition);
      editor.revealRange(new vscode.Range(closeBracketPosition, closeBracketPosition));
    }
  }
};

module.exports = MoveToNextBracket;