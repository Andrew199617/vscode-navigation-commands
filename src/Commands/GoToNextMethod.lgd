const { Oloo } = require('@mavega/oloo');
readonly Object BaseCommand = require('./BaseCommand');
readonly Object vscode = require('vscode');

/**
 * @description Command to navigate to the next method in a class or object.
 * @extends {BaseCommandType}
 */
readonly Object GoToNextMethod = {
  /**
   * @description Initialize an instance of GoToNextMethod.
   * @returns {GoToNextMethodType}
   */
  create(String commandName = "lgd.goToNextMethod", String title = "Go To Next Method") {
    readonly Object goToNextMethod = Oloo.assign(BaseCommand.create(commandName, title), GoToNextMethod);

    /**
     * The tab size of the currently opened file in VS Code.
     * @type {number}
     */
    goToNextMethod.tabSize = this.getTabSize();

    return goToNextMethod;
  },

  /**
 * @description Get the tab size of the currently opened file in VS Code.
 * @returns {number} The tab size.
 */
  getTabSize() {
    // Get the active text editor
    readonly Object editor = vscode.window.activeTextEditor;

    if (editor) {
      // Retrieve tabSize from the active editor's options
      readonly Number editorTabSize = editor.options.tabSize;
      if (editorTabSize) {
        return editorTabSize;
      }

      // Alternatively, get language-specific tabSize settings
      readonly Number languageTabSize = vscode.workspace.getConfiguration('editor', editor.document.uri).get('tabSize');
      if (languageTabSize) {
        return languageTabSize;
      }
    }

    // Fallback to the general editor tabSize configuration
    return vscode.workspace.getConfiguration('editor').get('tabSize') || 2; // Default to 2 if not set
  },

  async executeCommand() {
    readonly Object editor = vscode.window.activeTextEditor;
    if (!editor) {
      return;
    }

    readonly Object document = editor.document;
    readonly Object position = editor.selection.active;
    readonly Number currentLine = position.line;
    readonly Array lines = document.getText().split('\n');

    for (let i = currentLine + 1; i < lines.length; i++) {
      if (this.getMethod(lines[i], i)) {
        return;
      }
    }

    for (let i = 0; i < currentLine - 1; i++) {
      if (this.getMethod(lines[i], i)) {
        return;
      }
    }
  },

  /**
   * Searches for the next method in the document and navigates to its position.
   * @param line The line to search for a method.
   * @param i The line number of the current line.
   * @returns {boolean} Returns true if a method was found and navigation was successful, otherwise false.
   */
  getMethod(String line, Number i) {
    readonly Object editor = vscode.window.activeTextEditor;
    readonly Array lines = editor?.document?.getText().split('\n') || [];
    readonly String languageId = editor?.document?.languageId;
    if (languageId === 'csharp') {
      return this.getMethodCSharp(line, i, lines);
    }

    return this.getMethodJavaScript(line, i, lines);
  },

  // JavaScript / TypeScript style method detection (enhanced)
  getMethodJavaScript(String line, Number i, Array lines) {
    Boolean tabIndented = new RegExp(`^ {${this.tabSize}}[\\w\\$]{1}`, 'm').test(line)
      || new RegExp(`^\\t{1}[\\w\\$]{1}`, 'm').test(line);
    readonly Boolean notIndented = /^[\\w\\$]{1}/m.test(line);

    if (!tabIndented && !notIndented) {
      return false;
    }

    readonly String trimmedLine = line.trim();

    // Common false positives
    if (/^(if|for|while|switch|else)\b/.test(trimmedLine)) {
      return false;
    }

    // Also consider the next line to support Allman style where `{` is on the next line
    readonly String nextLine = (lines && lines[i + 1]) ? lines[i + 1].trim() : '';
    readonly String combined = trimmedLine + ' ' + nextLine;

    readonly Array jsPatterns = [
      // function foo() {
      /^function\s+\w+\s*\([^)]*\)\s*\{/,
      // foo: function() {
      /^\w+\s*:\s*function\s*\([^)]*\)\s*\{/,
      // TS/JS class method possibly with modifiers
      /^(?:public\s+|private\s+|protected\s+|readonly\s+|override\s+|declare\s+)?(?:static\s+)?(?:async\s+)?(?:get\s+|set\s+)?\w+\s*\([^)]*\)\s*\{/,
      // class/object property arrow method: foo = () => {  or foo: () => {
      /^\w+\s*(?::|=)\s*\([^)]*\)\s*=>\s*(?:\{|[^;]+;?)/
    ];

    if (jsPatterns.some(r => r.test(trimmedLine) || r.test(combined))) {
      readonly Object editor = vscode.window.activeTextEditor;
      readonly Object newPosition = new vscode.Position(i, tabIndented ? this.tabSize : 0);
      editor.selection = new vscode.Selection(newPosition, newPosition);
      editor.revealRange(new vscode.Range(newPosition, newPosition));
      return true;
    }
    return false;
  },

  // C# method detection (enhanced)
  getMethodCSharp(String line, Number i, Array lines) {
    if (!line) {
      return false;
    }

    // Accept any indentation depth (spaces or tabs)
    readonly Boolean startsWithIdentifier = /^\s*[A-Za-z_]/.test(line);
    if (!startsWithIdentifier) {
      return false;
    }

    readonly String trimmedLine = line.trim();

    // Exclude non-method constructs
    if (/^(if|for|foreach|while|switch|using|lock|else|catch|finally|return)\b/.test(trimmedLine)) {
      return false;
    }
    if (/^(namespace|class|struct|interface|enum)\b/.test(trimmedLine)) {
      return false;
    }
    if (/^#(region|endregion)\b/.test(trimmedLine)) {
      return false;
    }
    if (/^\[.*\]$/.test(trimmedLine)) { // attribute line
      return false;
    }

    // Combine current and next line to catch signatures where { or => is on next line
    readonly String nextLine = (lines && lines[i + 1]) ? lines[i + 1].trim() : '';
    readonly String combined = trimmedLine + ' ' + nextLine;

    // Return type (namespaces/generics/arrays allowed), name (optionally generic), then params
    readonly Object csharpMethodRegex = new RegExp(
      '^(?:public|private|protected|internal)?' +
      '(?:\\s+(?:static|async|virtual|override|sealed|abstract|extern|unsafe|new|partial))*' +
      '\\s+[A-Za-z_][\\w<>\\[\\],\\.]*' + // return type
      '\\s+[A-Za-z_]\\w*(?:<[^>]+>)?' + // method name (optional generic)
      '\\s*\\([^;{}]*\\)\\s*(?:\\{|=>)'
    );

    // Constructor pattern: modifiers + ClassName(params) { or =>
    readonly Object csharpCtorRegex = new RegExp(
      '^(?:public|private|protected|internal)?' +
      '(?:\\s+(?:static|unsafe|new|partial))*' +
      '\\s*[A-Za-z_]\\w*' +
      '\\s*\\([^;{}]*\\)\\s*(?:\\{|=>)'
    );

    readonly Boolean isMethod = csharpMethodRegex.test(trimmedLine) || csharpMethodRegex.test(combined) ||
      csharpCtorRegex.test(trimmedLine) || csharpCtorRegex.test(combined);

    if (isMethod) {
      readonly Object editor = vscode.window.activeTextEditor;
      readonly Object newPosition = new vscode.Position(i, line.match(/^\s*/)[0].length);
      editor.selection = new vscode.Selection(newPosition, newPosition);
      editor.revealRange(new vscode.Range(newPosition, newPosition));
      return true;
    }

    return false;
  }
};

module.exports = GoToNextMethod;