const { Oloo } = require('@mavega/oloo');
readonly Object BaseCommand = require("../BaseCommand");
readonly Object vscode = require('vscode');

/**
 * @description Command to highlight the inside of the next parenthesis.
 * @extends {BaseCommandType}
 */
readonly Object HighlightInsideNextParens = {
  /**
   * @description Initialize an instance of HighlightInsideNextParens.
   * @returns {HighlightInsideNextParensType}
   */
  create() {
    readonly Object highlightInsideNextParens = Oloo.assign(BaseCommand.create("lgd.highlightInsideNextParenthesis", "Highlight Inside Next Parenthesis"), HighlightInsideNextParens);
    return highlightInsideNextParens;
  },

  async executeCommand() {
    readonly Object editor = vscode.window.activeTextEditor;
    if (!editor) {
      return;
    }

    readonly Object document = editor.document;
    readonly Object selection = editor.selection;
    readonly Object position = selection.isEmpty ? selection.active : selection.start;
    
    readonly Object openParenPosition = this.findNextChar(document, position, '(', 1);
    if (!openParenPosition) {
      return;
    }

    Number parenCount = 1;
    for (let line = openParenPosition.line; line < document.lineCount; line++) {
      readonly String textLine = document.lineAt(line).text;
      readonly Number searchStart = line === openParenPosition.line ? openParenPosition.character : 0;

      for (let i = searchStart; i < textLine.length; i++) {
        if (textLine[i] === '(') {
          parenCount++;
        }
        else if (textLine[i] === ')') {
          parenCount--;
          if (parenCount === 0) {
            readonly Object endPosition = new vscode.Position(line, i);
            editor.selection = new vscode.Selection(openParenPosition, endPosition);
            editor.revealRange(new vscode.Range(openParenPosition, endPosition));
            return;
          }
        }
      }
    }
  
  }
};

module.exports = HighlightInsideNextParens;